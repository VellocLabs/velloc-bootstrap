# Pin to Siso (see args/Debug.gn for why): prevents autoninja from refusing
# to build when a stray .ninja_deps appears next to the Siso state.
use_siso = true
is_debug = false
enable_custom_browser = true

# No PCH: libc++ clang modules (on by default with C++23) cannot be combined
# with /Yc precompiled headers; precompile.cc fails with "missing 'export
# module' declaration".
enable_precompiled_headers = false

# Static-analysis only; codegen is unaffected.
clang_use_unsafe_buffers_plugin = false

# custom_browser (Velloc): browser executable base name (velloc.exe).
custom_browser_exe_name = "velloc"

# Never apply testing/variations/fieldtrial_testing_config.json: it turns on
# Chromium's experimental features (incl. Windows sandbox experiments) on every
# launch of a non-Google-branded build. custom_browser static_asserts this.
disable_fieldtrial_testing_config = true
