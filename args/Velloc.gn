# Set build arguments here. See `gn help buildargs`.
# =====================================================================
#  Fully Optimized Production Installer Build (Safe / Guaranteed)
# =====================================================================
enable_custom_browser = true
branding_path_component = "Velloc"
cc_wrapper = "sccache"
# branding_path_component = "Nextor"
is_debug = false
is_official_build = true
is_component_build = false        # REQUIRED for installer

symbol_level = 0                  # smallest binary, fastest build

target_cpu = "x64"
# No PCH: libc++ clang modules (on by default with C++23) cannot be combined
# with /Yc precompiled headers; precompile.cc fails with "missing 'export
# module' declaration". sccache does not cache PCH builds either.
enable_precompiled_headers = false

# Static-analysis only; codegen is unaffected.
clang_use_unsafe_buffers_plugin = false

# Installer
enable_chrome_installers = true
build_chrome_installer = true
chrome_pgo_phase = 0

# Media
ffmpeg_branding = "Chrome"
proprietary_codecs = true

# Remove deprecated features
enable_nacl = false

# Disable detailed debug info
blink_symbol_level = 0

# Branding
is_chrome_branded = false

# Windows-specific optimizations
enable_iterator_debugging = false
treat_warnings_as_errors = false

# custom_browser (Velloc): browser executable base name (velloc.exe).
custom_browser_exe_name = "velloc"

# Never apply testing/variations/fieldtrial_testing_config.json: it turns on
# Chromium's experimental features (incl. Windows sandbox experiments) on every
# launch of a non-Google-branded build. custom_browser static_asserts this.
disable_fieldtrial_testing_config = true
