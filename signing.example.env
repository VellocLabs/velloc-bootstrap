# Copy to signing.local.env (gitignored) and fill in once the Azure Trusted
# Signing identity validation is Completed and a Public Trust certificate
# profile exists. build.sh sources signing.local.env on every run.

# Master switch. 1 = sign (the default); 0 = unsigned package. The command
# line wins over this (`build.sh package --sign` / `--no-sign`), and so does
# VELLOC_SIGN set in the environment.
VELLOC_SIGN=1

# Azure portal -> Trusted Signing account -> Overview: "Account URI".
VELLOC_SIGN_ENDPOINT=https://eus.codesigning.azure.net
VELLOC_SIGN_ACCOUNT=
VELLOC_SIGN_PROFILE=

# From the Microsoft.Trusted.Signing.Client NuGet package:
#   bin/x64/Azure.CodeSigning.Dlib.dll
VELLOC_SIGN_DLIB=

# Optional overrides.
# VELLOC_SIGNTOOL="/c/Program Files (x86)/Windows Kits/10/bin/10.0.26100.0/x64/signtool.exe"
# VELLOC_SIGN_TIMESTAMP=http://timestamp.acs.microsoft.com
